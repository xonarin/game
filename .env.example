# Переменные окружения игры (скопируйте в .env для локального Docker; на сервере задайте в окружении).
# Не коммитьте реальные значения: всё, что попало в git, считается публичным.

# --- Обязательные в продакшене ----------------------------------------------
NODE_ENV=production
PORT=3000
# MySQL 8: mysql://user:password@host:3306/playtime
DATABASE_URL=
# Redis 7: redis://:password@host:6379
REDIS_URL=
# Папка SQL-миграций (применяются при старте). Пусто: production -> build/migrations рядом с server.js,
# иначе migrations/ в корне проекта. См. docs/DEPLOY.md «Автоприменение миграций».
MIGRATIONS_DIR=
# Подпись сессионных cookie. Случайная строка, минимум 32 символа: openssl rand -hex 32
JWT_SECRET=
# Публичный адрес сайта (secure cookie): https://plant.cash
PUBLIC_URL=
# Обратный прокси перед Node (Cloudflare Tunnel, nginx): число прокси-хопов или "loopback"
TRUST_PROXY=loopback

# --- Централизованный вход (plant-auth) --------------------------------------
# Соц-вход живёт только в plant-auth; игра ходит в брокер. См. docs/ARCHITECTURE.md.
# Публичный адрес брокера (куда ведут кнопки /login): https://auth.plant.cash
AUTH_SERVICE_URL=
# Внутренний адрес брокера для обмена кода (/verify), если отличается от публичного.
AUTH_SERVICE_INTERNAL_URL=
# Секрет этого сайта для /verify. Должен совпадать с секретом домена игры в админке «Домены»
# (AuthClient.secret). Сгенерировать: openssl rand -hex 32
GAME_VERIFY_SECRET=
# Токен сервисного GraphQL (заголовок X-Service-Token), которым plant-auth резолвит
# пользователей и проверяет секреты доменов. Должен совпадать с SERVICE_API_TOKEN в plant-auth.
SERVICE_API_TOKEN=

# --- Telegram: бонус и привязка аккаунта (НЕ вход — вход в plant-auth) --------
# Бот из @BotFather. Нужен для проверки подписки на канал и привязки Telegram к аккаунту.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Канал для бонуса: id вида -1001234567890 или @channel; бот должен быть админом канала.
TELEGRAM_BONUS_CHANNEL=
# Секрет вебхука бота (кто нажал «Старт»). После деплоя зарегистрировать:
#   https://api.telegram.org/bot<token>/setWebhook?url=<PUBLIC_URL>/api/telegram/webhook&secret_token=<этот>
TELEGRAM_WEBHOOK_SECRET=

# --- Платежи (выключены, пока пусто) -----------------------------------------
# FreeKassa (мерчант): депозиты и вебхук /api/v1/kassa/notify
FK_MERCHANT_ID=
FK_SECRET=
FK_SECRET2=
# FKWallet: выводы (почасовой cron)
FK_WALLET_ID=
FK_API_KEY=

# --- Только для локальной разработки -----------------------------------------
# DEV_LOGIN=1 включает dev-вход в брокере (plant-auth), в dev-сборке
# CLOUDFLARE_TUNNEL_TOKEN= (docker compose --profile tunnel)
