# Environment variables of the application (copy to .env for local Docker, set on the server in production).
# Never commit real values: anything in git is public.

# --- Required in production -------------------------------------------------
NODE_ENV=production
PORT=3000
# MySQL 8: mysql://user:password@host:3306/playtime
DATABASE_URL=
# Redis 7: redis://:password@host:6379
REDIS_URL=
# Signs session cookies. Random, at least 32 characters, e.g.: openssl rand -hex 32
JWT_SECRET=
# Public site URL (OAuth redirect URIs, secure cookies): https://plant.cash
PUBLIC_URL=
# Reverse proxy in front of Node (Cloudflare Tunnel, nginx): number of proxy hops or "loopback"
TRUST_PROXY=loopback

# --- Sign-in (only configured providers are shown on /login) -----------------
# VK ID app: https://id.vk.com/about/business/go (redirect URL: $PUBLIC_URL/auth/vk/return)
VKID_APP_ID=
# Telegram bot from @BotFather, domain linked with /setdomain
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Payments (disabled while empty) -----------------------------------------
# FreeKassa merchant: deposits and the /api/v1/kassa/notify webhook
FK_MERCHANT_ID=
FK_SECRET=
FK_SECRET2=
# FKWallet: withdrawals (hourly cron)
FK_WALLET_ID=
FK_API_KEY=

# --- VK group API (bonuses and promo codes) ------------------------------------
VK_APP_TOKEN=
VK_USER_TOKEN=
VK_GROUP_ID=
VK_GROUP_TOKEN=

# --- Local development only --------------------------------------------------
# DEV_LOGIN=1 enables /auth/dev in development builds
# CLOUDFLARE_TUNNEL_TOKEN= (docker compose --profile tunnel)
