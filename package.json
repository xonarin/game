        "dataloader-sequelize": "^2.3.3",
        "express": "^5",
        "express-jwt": "^8.5.1",
        "final-form": "^4.20",
        "graphql": "^16",
        "graphql-depth-limit": "^1.1.0",
        "graphql-middleware": "^6",
        "graphql-redis-subscriptions": "^2.7",
        "graphql-scalars": "^2.0.1",
        "graphql-shield": "^7.6.5",
        "graphql-subscriptions": "^2",
        "graphql-tag": "^2.12.6",
        "graphql-ws": "^6",
        "history": "^4.10.1",
        "ioredis": "^5",
        "isomorphic-style-loader": "^5.4",
        "jsonwebtoken": "^9",
